+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {orderRulerEntries,paintOrderPriceRuler} from '../public/modules/order-price-ruler.js';
+import {replayBracket} from '../public/modules/direction-exit-bracket.js';
+
+test('the ruler stays at the fill through rising prices, clears on neutral and resets on a flip',()=>{
+ const candles=[100,104,108,99,103,101,96].map(c=>({c}));
+ const bias=[0,1,1,0,1,-1,-1];
+ assert.deepEqual(orderRulerEntries(bias,candles,7),[null,104,104,null,103,101,101]);
+ assert.deepEqual(orderRulerEntries(bias,candles,3),[null,104,104]);
+});
+
+test('real bracket replay resets the ruler after an exit and same-bar same-side re-entry',()=>{
+ const candles=[100,112,113].map(c=>({o:c,h:c+1,l:c-1,c}));
+ const run={startBar:0,choices:[0,1,2].map(bar=>({bar,direction:1}))};
+ const bracket=replayBracket(run,candles,3,{version:1,actions:[{bar:0,enabled:true,distance:10}]});
+ assert.equal(bracket.exits[0].bar,1);
+ assert.deepEqual(orderRulerEntries([1,1,1],candles,3,bracket),[100,112,112]);
+});
+
+const rectangles=(side,entry,y)=>{
+ const result=[],ctx={fillStyle:null,fillRect(x,top,width,height){result.push([x,top,width,height,this.fillStyle])}};
+ paintOrderPriceRuler(ctx,12,8,20,100,y,side,entry,x=>x);
+ return result;
+};
+test('price bands are exactly ten points at any zoom and clip without bleed or overdraw',()=>{
+ const expected={1:['rgba(37,178,125,.15)','rgba(37,178,125,.045)'],'-1':['rgba(224,85,119,.16)','rgba(224,85,119,.048)']};
+ for(const side of [1,-1])for(const scale of [1,2.1,3]){
+  const y=p=>60-(p-100)*scale,[base,faded]=expected[side];
+  const hi=Math.min(y(100),y(100+side*10)),lo=Math.max(y(100),y(100+side*10));
+  assert.deepEqual(rectangles(side,100,y),[[12,20,8,hi-20,faded],[12,hi,8,lo-hi,base],[12,lo,8,100-lo,faded]]);
+  assert.deepEqual(rectangles(side,140,y).filter(r=>r[4]===base).length,scale===1&&side===-1?1:0);
+ }
+ assert.deepEqual(rectangles(1,90,p=>60-(p-100)*5),[[12,20,8,40,'rgba(37,178,125,.045)'],[12,60,8,40,'rgba(37,178,125,.15)']]);
+ assert.deepEqual(rectangles(1,null,p=>p),[[12,20,8,80,'rgba(37,178,125,.15)']]);
+});
+
+test('live simulator uses the fill-based ruler only on Daily Balance, not for prior bars or neutral',async()=>{
+ const {readFileSync}=await import('node:fs');
+ const html=readFileSync(new URL('../public/modules/market-direction.html',import.meta.url),'utf8');
+ const {default:vm}=await import('node:vm');
+ const renderer=html.match(/const entries=marketOnly&&c\.bias\.some.*?let xc=x\+step\/2;/s)?.[0];
+ assert.ok(renderer);
+ const colorCalls=[];
+ const sandbox={marketOnly:true,c:{revealed:3,bias:[1,0,-1],exitBracket:null},bars:[{c:100},{c:103},{c:99}],visible:[{prior:true,index:0},{index:0},{index:1},{index:2}],left:12,step:8,top:20,bottom:100,y:p=>60-(p-100)*2,ctx:{fillRect(){}},window:{patcPaint:x=>x},orderRulerEntries,paintOrderPriceRuler(...args){colorCalls.push(args.slice(1,8));}};
+ vm.runInNewContext('{'+renderer+'});}',sandbox);
+ assert.equal(colorCalls.length,2);
+ assert.deepEqual(colorCalls.map(a=>[a[0],a[5],a[6]]),[[20,1,100],[36,-1,99]]);
+ colorCalls.length=0;sandbox.marketOnly=false;
+ vm.runInNewContext('{'+renderer+'});}',sandbox);
+ assert.deepEqual(colorCalls.map(a=>a[6]),[undefined,undefined]);
+});
