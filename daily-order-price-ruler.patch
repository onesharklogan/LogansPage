diff --git a/public/modules/order-price-ruler.js b/public/modules/order-price-ruler.js
new file mode 100644
--- /dev/null
+++ b/public/modules/order-price-ruler.js
@@ -0,0 +1,44 @@
+// Display only: anchor each highlighted column to the fill that opened its leg.
+export const ORDER_RULER_POINTS = 10;
+
+export function orderRulerEntries(bias, candles, revealed, bracket = null) {
+ const entries = Array(revealed).fill(null);
+ if (bracket) {
+  for (const leg of bracket.legs) {
+   for (let i = leg.entryIndex; i <= leg.exitIndex && i < revealed; i++) {
+    if (bias[i] === leg.direction) entries[i] = leg.entryClose;
+   }
+  }
+  const open = bracket.position;
+  if (open) for (let i = open.entryIndex; i < revealed; i++) {
+   if (bias[i] === open.direction) entries[i] = open.entry;
+  }
+  return entries;
+ }
+ let direction = 0, entry = null;
+ for (let i = 0; i < revealed; i++) {
+  if (bias[i] !== direction) {
+   direction = bias[i];
+   entry = direction === 1 || direction === -1 ? candles[i]?.c ?? null : null;
+  }
+  entries[i] = entry;
+ }
+ return entries;
+}
+
+export function paintOrderPriceRuler(ctx, x, width, top, bottom, y, direction, entry, paint) {
+ const base = direction === 1 ? 'rgba(37,178,125,.15)' : 'rgba(224,85,119,.16)';
+ const faded = direction === 1 ? 'rgba(37,178,125,.045)' : 'rgba(224,85,119,.048)';
+ const draw = (from, to, color) => {
+  if (to <= from) return;
+  ctx.fillStyle = paint(color);
+  ctx.fillRect(x, from, width, to - from);
+ };
+ if (!Number.isFinite(entry)) { draw(top, bottom, base); return; }
+ const clip = yy => Math.min(bottom, Math.max(top, yy));
+ const start = clip(y(entry)), end = clip(y(entry + direction * ORDER_RULER_POINTS));
+ const upper = Math.min(start, end), lower = Math.max(start, end);
+ draw(top, upper, faded);
+ draw(upper, lower, base);
+ draw(lower, bottom, faded);
+}
