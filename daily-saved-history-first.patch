diff --git a/components/saved-desktop-sessions.tsx b/components/saved-desktop-sessions.tsx
new file mode 100644
--- /dev/null
+++ b/components/saved-desktop-sessions.tsx
@@ -0,0 +1,46 @@
+'use client';
+import {useEffect,useRef,useState,type MouseEvent} from 'react';
+import {learnerClient} from '../lib/learner/client.mjs';
+import {tradeHistoryFailureMessage} from '../lib/history-load.mjs';
+import {formatHistoryPoints} from '../lib/trade-history-chart.mjs';
+import LoadingIndicator from './loading-indicator';
+import styles from './learner-trader-stats.module.css';
+
+type Attempt={id:string;module:'trade-simulator'|'market-direction';chartId:string;completedAt:string;summary:{netPoints?:number;netAlignedPoints?:number}};
+type Capture=NonNullable<ReturnType<typeof learnerClient.captureContext>>;
+export default function SavedDesktopSessions({capture,onReady,onBack,onReplay,canAct}:{capture:Capture;onReady:()=>void;onBack:()=>void;onReplay:(e:MouseEvent<HTMLAnchorElement>)=>void;canAct:()=>boolean}){
+ const [rows,setRows]=useState<Attempt[]|null>(null),[next,setNext]=useState<string|null>(null),[failure,setFailure]=useState(''),[loading,setLoading]=useState(true);
+ const pending=useRef<AbortController|null>(null);
+ const live=()=>learnerClient.guard(capture);
+ function load(cursor?:string){
+  if(pending.current||!live())return;
+  const controller=new AbortController();
+  pending.current=controller;setLoading(true);setFailure('');
+  const current=()=>pending.current===controller&&live();
+  const timer=setTimeout(()=>{if(current()){setFailure('Saved sessions took too long to load.');setLoading(false);pending.current=null;}controller.abort();},12000);
+  void learnerClient.listAttempts({device:'desktop',limit:25,cursor},capture,{signal:controller.signal}).then(result=>{
+   if(!current())return;
+   setRows(previous=>cursor?[...new Map((previous||[]).concat(result.attempts).map(row=>[row.id,row])).values()]:result.attempts);
+   setNext(result.nextCursor);if(!cursor)onReady();
+  }).catch(error=>{if(current())setFailure(tradeHistoryFailureMessage(error));}).finally(()=>{
+   clearTimeout(timer);if(current()){pending.current=null;setLoading(false);}
+  });
+ }
+ useEffect(()=>{load();return()=>{pending.current?.abort();pending.current=null;};},[]);
+ if(!live())return null;
+ return <section aria-label="Saved desktop sessions">
+  <div className={styles.pager}><h3>Trade History</h3></div>
+  <div className={styles.toolbar}><button type="button" onClick={()=>{if(live()&&canAct())onBack();}}>Back to Trade Simulator</button></div>
+  <h4 className={styles.historyHeading}>Saved desktop sessions</h4>
+  {rows?.length===0&&<p>No saved desktop sessions yet.</p>}
+  {!!rows?.length&&<ul className={styles.savedSessions}>{rows.map(row=>{
+   const value=row.module==='market-direction'?row.summary.netAlignedPoints:row.summary.netPoints;
+   const date=row.chartId.match(/\d{4}-\d{2}-\d{2}/)?.[0]??row.chartId;
+   const url=row.module==='trade-simulator'?'/market-direction?history=1&review=':'/market-direction?replay=';
+   return <li key={row.id}><span><strong>{date}</strong><small>{new Date(row.completedAt).toLocaleString()}</small></span><span>{typeof value==='number'&&Number.isFinite(value)?`${formatHistoryPoints(value)} pts`:'Points unavailable'}</span><a href={url+encodeURIComponent(row.id)} onClick={e=>{if(!live()||!canAct()){e.preventDefault();return;}if(row.module==='trade-simulator'&&(e.ctrlKey||e.metaKey||e.shiftKey||e.altKey))return;onReplay(e);}}>{row.module==='trade-simulator'?'Review chart':'Replay'}</a></li>;
+  })}</ul>}
+  {loading&&<p role="status"><LoadingIndicator label="Loading saved sessions…" /></p>}
+  {failure&&<p role="alert">{failure} Your saved sessions haven’t changed.</p>}
+  {!loading&&(next||failure)&&<button type="button" onClick={()=>{if(live()&&canAct())load(next??undefined);}}>{failure?'Retry saved sessions':'Load older sessions'}</button>}
+ </section>;
+}
