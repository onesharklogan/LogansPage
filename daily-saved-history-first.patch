+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFile} from 'node:fs/promises';
+import {randomUUID} from 'node:crypto';
+import {createHistoryProjectionCache,projectAccountStats} from '../lib/learner/stats.mjs';
+import {createChartResolver} from '../lib/learner/charts.mjs';
+import {validateAttempt} from '../lib/learner/attempts.mjs';
+const asOf='2026-11-24T20:00:00.000Z',resolve=createChartResolver();
+const catalog=JSON.parse(await readFile(new URL('../public/charts/catalog.json',import.meta.url)));
+const entries=await Promise.all(catalog.sessions.slice(0,2).map(async ref=>{
+ const {attempt,summary,fingerprint}=await validateAttempt({version:1,id:randomUUID(),module:'market-direction',chartId:ref.id,chartSha256:ref.sha256,startedAt:'2026-11-24T18:01:00.000Z',completedAt:'2026-11-24T18:02:00.000Z',practice:{run:{version:1,choices:[{bar:0,direction:1},{bar:1,direction:1},{bar:2,direction:1},{bar:3,direction:-1}],practiceCutoff:4},finalBar:4}},resolve,Date.parse(asOf));
+ return {module:attempt.module,payload:attempt,summary,fingerprint,saved_at:Date.parse(asOf)};
+}));
+const context={accountId:randomUUID(),generation:1,sessionTag:'a'.repeat(64)};
+
+test('a timeout retains completed projections, subsequent loads avoid chart replay without changing results',async()=>{
+ const projectionCache=createHistoryProjectionCache();
+ let t=0,chartsRead=[];
+ const opts={context,asOf,projectionCache,clock:()=>t,charts:async(id,hash)=>{chartsRead.push(id);if(id===entries[1].payload.chartId)t=8001;return resolve(id,hash);}};
+ await assert.rejects(projectAccountStats(entries,opts),{code:'stats_budget'});
+ chartsRead=[];t=0;
+ const counted=async(id,hash)=>{chartsRead.push(id);return resolve(id,hash);};
+ const recovered=await projectAccountStats(entries,{...opts,charts:counted});
+ assert.deepEqual(chartsRead,[entries[1].payload.chartId]);
+ assert.ok(recovered.attempts.every(a=>a.outcomes!==null));
+ assert.deepEqual(recovered,await projectAccountStats(entries,{context,asOf,charts:resolve}));
+ chartsRead=[];
+ assert.deepEqual(recovered,await projectAccountStats(entries,{...opts,charts:counted}));
+ assert.deepEqual(chartsRead,[]);
+});
+
+test('cache does not cross owner or generation, or hide mismatched history',async()=>{
+ const projectionCache=createHistoryProjectionCache(1);
+ const opts={context,asOf,projectionCache,charts:resolve};
+ await projectAccountStats(entries,opts);
+ let calls=0;const counted=async(...args)=>{calls++;return resolve(...args);};
+ await projectAccountStats([entries[0]],{...opts,charts:counted});assert.equal(calls,1,'bounded eviction');
+ await projectAccountStats([entries[0]],{...opts,charts:counted,context:{...context,generation:2}});assert.equal(calls,2);
+ await projectAccountStats([entries[0]],{...opts,charts:counted,context:{...context,accountId:randomUUID()}});assert.equal(calls,3);
+ const changed={...entries[0],summary:{...entries[0].summary,netAlignedPoints:999}};
+ const outcome=await projectAccountStats([changed],{...opts,charts:counted});assert.equal(calls,4);assert.equal(outcome.attempts[0].outcomes,null);
+});
