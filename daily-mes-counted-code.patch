+// Supplemental account proof is separately authorized and validated server-side against immutable bytes.
+// Never changes or substitutes any public historic proof row.
+import {loadHistoryCandleIndex,validateHistoryCandleIndex} from './history-candle-data.js';
+const id=/^mesmock1-\d{4}-\d{2}-\d{2}-(?:45|78)$/;
+export async function loadPracticeHistoryCandleIndex(options={}){
+ const legacy=await loadHistoryCandleIndex(options);
+ if(options.includePrivate===false||typeof location==='undefined'||location.origin!=='https://dailybalancelogan.onrender.com')return legacy;
+ try{
+  const response=await fetch('/api/learner/mock-charts/proof',{signal:options.signal,credentials:'same-origin',redirect:'error',cache:'no-store',referrerPolicy:'no-referrer'});
+  if(response.status===404)return legacy;
+  if(!response.ok||response.redirected)throw Error('The additional MES practice history could not be verified.');
+  const text=await response.text();if(new TextEncoder().encode(text).byteLength>128*1024)throw Error('The additional MES practice history is invalid.');
+  const data=JSON.parse(text);
+  if(data?.version!==1||!Array.isArray(data.sessions)||!data.sessions.length||data.sessions.length>8||data.sessions.some(row=>!id.test(row.id)||legacy.get(row.key)||row.closes?.length!==Number(row.id.slice(-2))))throw Error('The additional MES practice history is invalid.');
+  const extra=validateHistoryCandleIndex({version:1,identity:legacy.identity,sourceCatalogSha256:legacy.sourceCatalogSha256,sessions:data.sessions});
+  options.signal?.throwIfAborted?.();
+  return Object.freeze({version:1,identity:legacy.identity,sourceCatalogSha256:legacy.sourceCatalogSha256,sessions:Object.freeze([...legacy.sessions,...extra.sessions]),get:key=>legacy.get(key)||extra.get(key)});
+ }catch(error){if(options.signal?.aborted||error?.name==='AbortError')throw error;return legacy;}
+}
