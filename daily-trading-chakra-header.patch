diff --git a/components/daily-chakra-clock.tsx b/components/daily-chakra-clock.tsx
new file mode 100644
--- /dev/null
+++ b/components/daily-chakra-clock.tsx
@@ -0,0 +1,25 @@
+'use client';
+
+import {createContext,useContext,useEffect,useState,type ReactNode} from 'react';
+import {hourlyClock} from '../lib/learner/daily-hourly.mjs';
+import {tradingHeaderChakra} from '../lib/chakra-focus.mjs';
+
+const DayContext = createContext<string|null>(null);
+
+export default function DailyChakraClock({initialDay,children}:{initialDay:string|null;children:ReactNode}){
+ const [day,setDay]=useState(initialDay);
+ useEffect(()=>{
+   if(initialDay===null)return;
+   const sync=()=>setDay(hourlyClock().day);
+   sync();
+   const id=window.setInterval(sync,15_000);
+   window.addEventListener('focus',sync);
+   document.addEventListener('visibilitychange',sync);
+   return ()=>{window.clearInterval(id);window.removeEventListener('focus',sync);document.removeEventListener('visibilitychange',sync);};
+ },[initialDay]);
+ return <DayContext.Provider value={day}>{children}</DayContext.Provider>;
+}
+
+export function useTradingChakra(current:string|undefined,section:string){
+ return tradingHeaderChakra(useContext(DayContext),current,section);
+}
