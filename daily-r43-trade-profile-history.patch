ollow latest candle" hidden>⇥</button><div id="emptySession" hidden role="group" aria-labelledby="emptySessionTitle"><h2 id="emptySessionTitle">Open a session to begin</h2><button id="openEmptySession" type="button" aria-describedby="emptySessionHint emptySessionError">Open session</button><p id="emptySessionHint">Choose a date or pick a random session.</p><p id="emptySessionError" hidden></p></div><div class="progress"><i id="progress"></i></div></section><div id="chartGuide" hidden inert aria-hidden="true"><p id="emaNote"></p><p id="pivotSummary"></p><div id="barValues"></div></div><p id="directionPrompt" role="status" aria-live="polite" hidden>Choose Long, Short or Neutral to start.</p><div class="controls"><div class="group"><button id="up" aria-describedby="directionPrompt" aria-keyshortcuts="ArrowUp W" class="up" aria-pressed="false">▲ Long (↑/W)</button><button id="down" aria-describedby="directionPrompt" aria-keyshortcuts="ArrowDown S" class="down" aria-pressed="false">▼ Short (↓/S)</button><button id="neutral" aria-describedby="directionPrompt" aria-keyshortcuts="N" class="neutral" aria-pressed="false">● Neutral (N)</button></div><div class="group"><button id="next" aria-label="Next candle (Right arrow or D)" aria-keyshortcuts="ArrowRight D">Next →</button><div id="finishCluster"><button id="randomSessionAction" type="button" hidden disabled title="Load a random available session">Random Session</button><button id="finish" class="primary" disabled>🏁 Finish</button><button id="sessionOptionsToggle" hidden aria-label="More next session options" aria-haspopup="menu" aria-expanded="false">▲</button></div></div></div><div id="completedNavigationStatus" role="status" aria-live="polite" hidden style="margin:6px 0;color:var(--appearance-ink-e7bc83, #e7bc83);font-size:12px"><span id="completedNavigationMessage"></span> <button id="completedNavigationRetry" type="button" data-account-save-retry="true" hidden style="min-height:44px">Retry save</button></div><div id="sessionRangeControls" aria-label="Next session bar range"><label for="firstBarSetting">First Bar<input id="firstBarSetting" type="number" inputmode="numeric" min="1" max="81" step="1" value="5" aria-describedby="finalBarHint"></label><label for="finalBarSetting">Final Bar<input id="finalBarSetting" type="number" inputmode="numeric" min="1" max="81" step="1" value="78" aria-describedby="finalBarHint"></label><button id="rangeApply" type="button">Apply next session</button><output id="closedLegPoints" role="status" aria-live="polite" aria-atomic="true" hidden>0 Points</output><p id="finalBarHint" class="muted" role="status" aria-live="polite"></p></div><div id="orderSettings" aria-label="Order settings"></div><div class="viewControls" aria-label="Chart view controls"><button id="openPatternFinder" type="button" disabled>Open in Pattern Finder ↗</button><button id="indicatorsOpen" aria-label="Indicators" title="Indicators" aria-haspopup="dialog" aria-expanded="false">◆</button><button id="idlePickDate" hidden>Pick date</button><button id="idlePickRandom" hidden>Random chart</button><button id="cancelSession">Cancel session</button><button id="retryReal" title="Retry loading a historical chart" hidden>Retry</button><button id="replayChart" hidden aria-label="Replay Session" title="Replay Session">Replay Session</button><div id="chartMatcherAction"><button id="openChartMatcher" type="button" disabled aria-describedby="chartMatcherHint" title="Open this visible chart in Chart Matcher"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 3v14h7M6 12l3-4 3 2 3-5"/><circle cx="16" cy="16" r="4"/><path d="m19 19 3 3"/></svg><span>Open Chart Matcher</span></button><p id="chartMatcherHint" role="status" aria-live="polite" aria-atomic="true">Reveal 7 opening bars to use Chart Matcher.</p></div><button id="fitView" aria-label="Fit chart" title="Reset both axes · readable candles on compact screens">⛶</button><div id="sessionActions" role="group" aria-label="Session navigation"><button id="nextSessionAction" type="button" title="Load the next available session by date">Next Session</button><button id="hostedOpen" type="button" title="Choose a historical session" aria-haspopup="dialog">Select Session</button></div></div><p id="chartMatcherStatus" role="status" aria-live="polite" hidden></p><p id="chartMatcherError" role="alert" hidden></p><div class="status" id="status" role="status" aria-live="polite">Enter your name to start.</div><div id="marketReadout" hidden inert aria-hidden="true"><div class="topline"><div><strong>MES · 5 minute</strong> <span class="tag" id="dataTag">HISTORICAL MES</span></div><span class="muted" id="chartId" hidden>Practice chart</span></div><div class="muted" id="sessionInfo" style="margin:0 0 10px;font-size:12px">Prior-session context · America/Chicago</div><strong id="price">Waiting for profile</strong><div id="gestureHint" style="font-size:10px;line-height:12px;color:var(--appearance-ink-a9b7c8, #a9b7c8);padding-top:3px">Drag price ↑ or time ← to zoom in · chart drag pans · double-tap axis resets</div></div><details id="chartLegDetails" hidden class="muted" style="font-size:12px;margin:8px 0"><summary id="chartLegSummary">Closed bias legs</summary><ol id="chartLegList"></ol></details><section id="historyPanel" hidden style="margin:18px 0;padding:18px;border:1px solid var(--appearance-line-344254, #344254);border-radius:12px"><div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><h2 style="font-size:20px;margin:0">Practice history</h2><button id="historyClose">Close history</button></div><p class="muted">Points are your practice score. Review your completed runs and the decisions behind them.</p><div id="latestReport"></div><div id="historyDashboard"></div><section id="historyTimeBuckets" aria-label="Aligned points by ending bar"></section><p id="legacyHistory" class="muted"></p><div style="overflow-x:auto"><table style="width:100%;min-width:380px;border-collapse:collapse;text-align:left;font-size:13px"><thead><tr><th>Session</th><th>Points on Last Run</th><th scope="col" style="text-align:center">Attempts</th><th><span class="muted">Practice</span></th></tr></thead><tbody id="historyRows"></tbody></table></div><p class="muted">Points follow your recorded long/short bias between candle closes. Each closed leg ends at a flip close; the final leg ends at the last recorded close. Flat moves add zero points. Sessions start Neutral with no exposure; choose Long or Short whenever ready. Neutral closes the current leg at the visible candle close and adds no points until Long or Short is chosen. Older unrecorded movement is never backfilled. With Use exit bracket, points end at the verified bracket fill instead; the rest of that bar is not scored. These are practice points, not trading P&amp;L.</p></section><div class="footer" id="storageNotice">Local profiles · Clearing browser data removes your progress.</div><div id="chartMatcherContainer"></div></main><section class="gate" id="welcomeGate" hidden><div class="panel" role="dialog" aria-modal="true" aria-labelledby="welcomeTitle" aria-describedby="welcomeIntro" style="width:min(580px,100%);min-width:0;max-height:calc(100dvh - 28px);overflow:auto;padding:26px;overflow-wrap:anywhere"><a class="module-modal-home" href="/" target="_top" aria-label="Home" title="Home"><svg class="module-candle-mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="24" cy="24" r="9"/><path d="M24 3v5m0 32v5M3 24h5m32 0h5M9 9l4 4m22 22 4 4M9 39l4-4m22-22 4-4"/></svg><span class="module-sr-only">Price Action Center</span></a><h2 id="welcomeTitle" style="font-size:30px;line-height:1.15;margin:16px 0">Practice reading the market.</h2><p id="welcomeIntro" style="font-size:18px;line-height:1.45;color:var(--appearance-ink-e2edf7, #e2edf7)">Train your market-direction bias, not perfect entries and exits.</p><ol style="padding-left:22px;line-height:1.55;color:var(--appearance-ink-c8d6e4, #c8d6e4)"><li style="padding-left:3px;margin-bottom:14px">Go bar by bar. Sessions start Neutral with no exposure. Choose Long or Short whenever ready. Change your choice as your bias changes.</li><li style="padding-left:3px">Replay days that finished at zero or negative points. Focus on the decisions that cost the most points.</li></ol><p style="font-size:12px;line-height:1.5;color:var(--appearance-ink-9fb3c7, #9fb3c7);padding:14px;background:var(--appearance-surface-0b1723, #0b1723);border:1px solid var(--appearance-line-293e52, #293e52);border-radius:9px">Your results are saved only in this browser’s profile. They aren’t uploaded or shared with us, and you can clear or delete them anytime.</p><button id="welcomeContinue" class="primary" style="min-height:42px;width:100%;margin-top:7px">Start Practicing</button></div></section><section id="indicatorsPanel" hidden role="dialog" aria-labelledby="indicatorsTitle" style="position:fixed;z-index:101;background:var(--appearance-surface-142437, #142437);border:1px solid var(--appearance-line-46617b, #46617b);border-radius:10px;padding:12px;box-shadow:0 10px 30px var(--appearance-shadow-0008, #0008)"><strong id="indicatorsTitle">Indicators</strong><label style="display:flex;align-items:center;gap:8px;font-size:12px;margin-top:10px"><input id="ema20Visible" type="checkbox" style="width:20px;height:20px;margin:0" checked>EMA20 · fixed period 20</label><label style="display:flex;align-items:center;gap:8px;font-size:12px;margin-top:10px"><input id="pivotDiamonds" type="checkbox" style="width:20px;height:20px;margin:0">Pivot Point Diamonds</label><p style="font-size:11px;line-height:1.4;color:var(--appearance-ink-b1c2d3, #b1c2d3);margin-bottom:0">Current-session only. Strict three-candle highs/lows; each diamond appears after the following candle is revealed. Equal highs/lows do not qualify. After Finish only, brighter diamonds mark pivots not broken by the next five session candles; touches count as holding. Retrospective study, not a trade guarantee.</p></section><section id="sessionOptions" hidden role="menu" aria-label="Next session options. Up or W, Down or S to move." aria-keyshortcuts="ArrowUp ArrowDown W S"><button id="randomSession" role="menuitem" disabled>Random session</button><button id="losingSession" role="menuitem" disabled>Replay past losing session</button><p id="sessionOptionsStatus" role="status"></p></section><section class="gate" id="hostedGate" hidden aria-labelledby="hostedTitle"><div class="panel" role="dialog" aria-modal="true" style="max-height:90vh;overflow-y:auto"><a class="module-modal-home" href="/" target="_top" aria-label="Home" title="Home"><svg class="module-candle-mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="24" cy="24" r="9"/><path d="M24 3v5m0 32v5M3 24h5m32 0h5M9 9l4 4m22 22 4 4M9 39l4-4m22-22 4-4"/></svg><span class="module-sr-only">Price Action Center</span></a><h2 id="hostedTitle">Choose a session</h2><button id="hostedReload" type="button" hidden>Reload dates</button><span id="hostedDownload" hidden></span><select id="hostedSelect" hidden aria-hidden="true" tabindex="-1" disabled></select><div id="hostedCalendar" hidden role="group" aria-labelledby="hostedTitle"><div class="hostedCalendarNav"><button id="hostedPreviousYear" type="button" aria-label="Previous year" disabled>«</button><button id="hostedPreviousMonth" type="button" aria-label="Previous month" disabled>‹</button><strong id="hostedCalendarMonth" aria-live="polite">Session dates</strong><button id="hostedNextMonth" type="button" aria-label="Next month" disabled>›</button><button id="hostedNextYear" type="button" aria-label="Next year" disabled>»</button></div><label class="calendarYearJump">Jump t