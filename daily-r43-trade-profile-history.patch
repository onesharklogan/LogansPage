+ f.fail('identity',Error(privateSentinel));response=await f.read();assert.equal(response.status,503);assert.equal((await response.json()).code,'learner_unavailable');
+ f.fail('projection',new LearnerError(503,'stats_budget',privateSentinel));response=await f.read();assert.equal(response.status,503);assert.equal((await response.json()).code,'stats_budget');
