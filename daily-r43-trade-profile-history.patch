+ const repository={stats:async()=>{if(mode==='waiting')return new Promise(resolve=>release=resolve);if(mode==='projection')throw problem;return {success:true};}};
+ const handler=createLearnerService({origin,repository,charts:()=>{},csrfSecret:'a'.repeat(32),identityProvider:{issuer,resolve:async()=>{if(mode==='identity')throw problem;if(mode!=='guest')return owner();return null;}},now:()=>time,statsDiagnostic:value=>diag.push(value)});
