diff --git a/lib/learner/history-diagnostics.mjs b/lib/learner/history-diagnostics.mjs
new file mode 100644
--- /dev/null
+++ b/lib/learner/history-diagnostics.mjs
@@ -0,0 +1,19 @@
+// Operational markers: no identifiers, IP, request contents, error text, timing or query string.
+const stages=new Set(['owner_gate','identity','projection']);
+const categories=new Set(['auth','identity_service','busy','projection_timeout','history_unverified','database_timeout','service']);
+export function createHistoryDiagnostics(log=marker=>console.warn('[daily-trade-history-read]',JSON.stringify(marker)),now=Date.now){
+ let lastMinute=-1,counts=0;
+ return (stage,category)=>{
+  if(!stages.has(stage)||!categories.has(category))return;
+  try{
+   const minute=Math.floor(now()/60000);if(minute!==lastMinute){lastMinute=minute;counts=0;}
+   if(counts>=5)return;counts++;
+   log({stage,category});
+  }catch{}
+ };
+}
+const gateDiagnostics=createHistoryDiagnostics();
+export function recordHistoryAccessDenial(request,status,record=gateDiagnostics){
+ if(request.method!=='GET'||new URL(request.url).pathname!=='/api/learner/stats')return;
+ record('owner_gate',status===401||status===403?'auth':'identity_service');
+}
