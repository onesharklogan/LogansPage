diff --git a/migrations/043_dream_journal.sql b/migrations/043_dream_journal.sql
new file mode 100644
--- /dev/null
+++ b/migrations/043_dream_journal.sql
@@ -0,0 +1,15 @@
+-- Additive, append-only journal for Daily Balance accounts.
+BEGIN;
+CREATE TABLE IF NOT EXISTS learner_app.dream_journal (
+ account_id uuid NOT NULL REFERENCES learner_app.accounts(id),
+ entry_id uuid NOT NULL,
+ dream_date date NOT NULL CHECK(dream_date >= DATE '2020-01-01'),
+ dream_text text NOT NULL CHECK(char_length(dream_text) BETWEEN 1 AND 8000 AND length(btrim(dream_text))>0),
+ lucid boolean NOT NULL,
+ created_at bigint NOT NULL CHECK(created_at>0),
+ PRIMARY KEY(account_id,entry_id)
+);
+CREATE INDEX IF NOT EXISTS dream_journal_owner_order ON learner_app.dream_journal(account_id,created_at DESC,entry_id DESC);
+REVOKE ALL ON learner_app.dream_journal FROM PUBLIC;
+GRANT SELECT, INSERT ON learner_app.dream_journal TO learner_runtime;
+COMMIT;
