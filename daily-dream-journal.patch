+++ b/lib/learner/dream-journal.mjs
@@ -0,0 +1,37 @@
+import {fail,keys,uuid} from './validation.mjs';
+import {dateKey,todayKey} from './daily.mjs';
+
+const pageSize=20;
+const ownerContext=(a,s)=>({accountId:a.id,generation:a.generation,sessionTag:s.session_tag});
+const columns='entry_id,dream_date::text AS dream_date,dream_text,lucid,created_at';
+const entry=row=>({id:row.entry_id,date:row.dream_date,text:row.dream_text,lucid:row.lucid,savedAt:Number(row.created_at)});
+
+export function dreamJournalCommand(value){
+ keys(value,['context','id','date','text','lucid']);
+ if(!uuid(value.id)||typeof value.text!=='string'||!value.text.trim()||value.text.length>8000||/[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f\p{Cs}]/u.test(value.text)||typeof value.lucid!=='boolean'){
+  fail(400,'invalid_dream','Write between 1 and 8,000 characters and choose whether the dream was lucid.');
+ }
+ return {...value,text:value.text.trim().replace(/\r\n?/g,'\n')};
+}
+
+export class DreamJournalRepository {
+ constructor(repository){this.repository=repository;}
+ list(p,now,before){return this.repository.owned(p,now,false,async(db,a,s,time)=>{
+  const args=[a.id,pageSize+1];
+  if(before)args.push(before.savedAt,before.id);
+  const {rows}=await db.query('SELECT '+columns+' FROM learner_app.dream_journal WHERE account_id=$1'+
+   (before?' AND (created_at,entry_id)<($3,$4)':'')+' ORDER BY created_at DESC,entry_id DESC LIMIT $2',args);
+  const entries=rows.slice(0,pageSize).map(entry),last=entries.at(-1);
+  const nextCursor=rows.length>pageSize&&last?Buffer.from(JSON.stringify({savedAt:last.savedAt,id:last.id})).toString('base64url'):null;
+  return {context:ownerContext(a,s),today:todayKey(time),entries,nextCursor};
+ });}
+ write(p,now,context,value){return this.repository.owned(p,now,false,async(db,a,s,time)=>{
+  this.repository.check(a,s,context);
+  const date=dateKey(value.date,todayKey(time));
+  const args=[a.id,value.id,date,value.text,value.lucid,time];
+  const {rows:[inserted]}=await db.query('INSERT INTO learner_app.dream_journal(account_id,entry_id,dream_date,dream_text,lucid,created_at) VALUES($1,$2,$3,$4,$5,$6) ON CONFLICT DO NOTHING RETURNING '+columns,args);
+  const saved=entry(inserted??(await db.query('SELECT '+columns+' FROM learner_app.dream_journal WHERE account_id=$1 AND entry_id=$2',args.slice(0,2))).rows[0]);
+  if(saved.date!==date||saved.text!==value.text||saved.lucid!==value.lucid)fail(409,'dream_conflict','That save ID is already in use. Nothing was overwritten.');
+  return {context:ownerContext(a,s),entry:saved};
+ });}
+}
