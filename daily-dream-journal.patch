diff --git a/components/dream-journal.tsx b/components/dream-journal.tsx
new file mode 100644
--- /dev/null
+++ b/components/dream-journal.tsx
@@ -0,0 +1,99 @@
+'use client';
+import {useEffect,useRef,useState,type FormEvent} from 'react';
+import styles from './dream-journal.module.css';
+
+type Owner={accountId:string;generation:number;sessionTag:string};
+type Entry={id:string;date:string;text:string;lucid:boolean;savedAt:number};
+type Page={context:Owner;today:string;entries:Entry[];nextCursor:string|null};
+type Saved={context:Owner;entry:Entry};
+type Props={owner?:Owner;today?:string;csrf:string};
+const endpoint='/api/learner/dream-journal';
+const keyOf=(owner?:Owner)=>owner?JSON.stringify([owner.accountId,owner.generation,owner.sessionTag]):'';
+const formatDay=new Intl.DateTimeFormat('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'});
+
+async function request<T extends Page|Saved>(path:string,key:string,init?:RequestInit):Promise<T>{
+ const response=await fetch(path,{...init,credentials:'same-origin',cache:'no-store'});
+ const value=await response.json();
+ if(!response.ok)throw Object.assign(Error(value.error||'The journal is unavailable.'),{status:response.status});
+ if(keyOf(value.context)!==key)throw Error('The journal response could not be verified.');
+ return value;
+}
+const authError=(error:unknown)=>[401,403].includes((error as {status?:number})?.status??0);
+
+export default function DreamJournal(props:Props){
+ // The dashboard temporarily clears its snapshot while refreshing. Keep in-memory drafts
+ // for the same account/session, but render nothing until its verified context returns.
+ const lastKey=useRef('');
+ if(props.owner)lastKey.current=keyOf(props.owner);
+ return <Journal key={lastKey.current} {...props} ownerKey={lastKey.current}/>;
+}
+
+function Journal({owner,today,csrf,ownerKey}:Props&{ownerKey:string}){
+ const [entries,setEntries]=useState<Entry[]>([]),[cursor,setCursor]=useState<string|null>(null);
+ const [ready,setReady]=useState(false),[loading,setLoading]=useState(false),[saving,setSaving]=useState(false),[retry,setRetry]=useState(0);
+ const [text,setText]=useState(''),[lucid,setLucid]=useState(false),[chosenDate,setChosenDate]=useState('');
+ const [error,setError]=useState(''),[status,setStatus]=useState('');
+ const pending=useRef<{kind:'save'|'page';controller:AbortController}|null>(null);
+ const intention=useRef<{draft:string;id:string}|null>(null);
+ const shouldLoad=!!owner&&!ready;
+ useEffect(()=>{
+  if(!shouldLoad)return;
+  const controller=new AbortController();setLoading(true);setError('');
+  void request<Page>(endpoint,ownerKey,{signal:controller.signal}).then(result=>{
+   if(controller.signal.aborted)return;
+   setEntries(result.entries);setCursor(result.nextCursor);setLoading(false);setReady(true);
+  }).catch(e=>{if(!controller.signal.aborted){setEntries([]);setCursor(null);setError(e.message||'Could not load the journal.');}})
+   .finally(()=>{if(!controller.signal.aborted)setLoading(false);});
+  return()=>controller.abort();
+ },[shouldLoad,ownerKey,retry]);
+ useEffect(()=>()=>pending.current?.controller.abort(),[]);
+ const date=chosenDate||today||'';
+ function failed(e:unknown,message:string){
+  if(authError(e)){setEntries([]);setCursor(null);setReady(false);}
+  setError(e instanceof Error?e.message:message);
+ }
+ async function submit(event:FormEvent<HTMLFormElement>){
+  event.preventDefault();
+  if(!owner||!ready||pending.current||!text.trim()||!date)return;
+  const draft=JSON.stringify([date,text,lucid]);
+  if(intention.current?.draft!==draft)intention.current={draft,id:crypto.randomUUID()};
+  const {id}=intention.current,controller=new AbortController();
+  pending.current={kind:'save',controller};setChosenDate(date);setSaving(true);setError('');setStatus('');
+  try{
+   const result=await request<Saved>(endpoint,ownerKey,{method:'POST',headers:{'Content-Type':'application/json','X-CSRF-Token':csrf},body:JSON.stringify({context:owner,id,date,text,lucid}),signal:controller.signal});
+   if(controller.signal.aborted)return;
+   if(result.entry?.id!==id||result.entry.date!==date||result.entry.lucid!==lucid||result.entry.text!==text.trim().replace(/\r\n?/g,'\n'))throw Error('The save could not be verified. Retry without changing your draft.');
+   setEntries(prev=>[result.entry,...prev.filter(item=>item.id!==id)].sort((a,b)=>b.savedAt-a.savedAt||(b.id>a.id?1:b.id<a.id?-1:0)));
+   intention.current=null;setText('');setLucid(false);setChosenDate('');setStatus('Dream saved.');
+  }catch(e){if(!controller.signal.aborted)failed(e,'Save not confirmed. Your draft is still here.');}
+  finally{if(!controller.signal.aborted){pending.current=null;setSaving(false);}}
+ }
+ async function older(){
+  if(!owner||!ready||!cursor||pending.current)return;
+  const controller=new AbortController();pending.current={kind:'page',controller};setLoading(true);setError('');
+  try{
+   const result=await request<Page>(endpoint+'?cursor='+encodeURIComponent(cursor),ownerKey,{signal:controller.signal});
+   if(controller.signal.aborted)return;
+   setEntries(prev=>[...prev,...result.entries.filter(item=>!prev.some(existing=>existing.id===item.id))]);
+   setCursor(result.nextCursor);
+  }catch(e){if(!controller.signal.aborted)failed(e,'Could not load older dreams.');}
+  finally{if(!controller.signal.aborted){pending.current=null;setLoading(false);}}
+ }
+ if(!owner||!today)return null;
+ return <section className={styles.panel} aria-labelledby="dream-journal-heading">
+  <h2 id="dream-journal-heading">Dream Journal</h2>
+  <form onSubmit={submit}>
+   <label className={styles.field}>Dream date<input type="date" required min="2020-01-01" max={today} value={date} disabled={saving} onChange={e=>{setChosenDate(e.target.value);setStatus('');}}/></label>
+   <label className={styles.field}>What do you remember?<textarea rows={4} maxLength={8000} placeholder="Write down what happened in your dream…" required value={text} disabled={saving} onChange={e=>{setText(e.target.value);setStatus('');}}/></label>
+   <label className={styles.lucid}><input type="checkbox" checked={lucid} disabled={saving} onChange={e=>{setLucid(e.target.checked);setStatus('');}}/><span><strong>Lucid dream</strong><small>I realized I was dreaming and tried to interact with the dream.</small></span></label>
+   <button type="submit" disabled={!ready||saving||loading||!text.trim()}>{saving?'Saving…':'Save dream'}</button>
+  </form>
+  {status&&<p role="status">{status}</p>}
+  {error&&<p role="alert">{error}{!ready&&!loading&&<> <button type="button" onClick={()=>setRetry(n=>n+1)}>Try again</button></>}</p>}
+  {loading&&!ready&&<p role="status">Loading your dream journal…</p>}
+  {ready&&entries.length>0&&<details className={styles.archive}><summary>Saved dreams</summary>
+   <ul>{entries.map(item=><li key={item.id}><div className={styles.entryHeading}><time dateTime={item.date}>{formatDay.format(new Date(item.date+'T12:00:00Z'))}</time><span>{item.lucid?'Lucid':'Not lucid'}</span></div><p>{item.text}</p></li>)}</ul>
+   {cursor&&<button type="button" disabled={loading||saving} onClick={()=>void older()}>{loading?'Loading…':'Show older dreams'}</button>}
+  </details>}
+ </section>;
+}
