+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {randomUUID} from 'node:crypto';
+import {PGlite} from '@electric-sql/pglite';
+import {LearnerRepository} from '../lib/learner/repository.mjs';
+import {createLearnerService} from '../lib/learner/server.mjs';
+import {DAILY_BALANCE_ORIGIN,LEARNER_ORIGIN} from '../lib/learner/google-config.mjs';
+import {restrictToPrivateOwner,PRIVATE_OWNER_EMAIL} from '../lib/learner/private-owner.mjs';
+
+const read=path=>readFileSync(new URL('../'+path,import.meta.url),'utf8');
+const ddl=read('migrations/043_dream_journal.sql');
+test('private journal persists multiple dated entries, retries safely and pages without leaking between accounts',async()=>{
+ const db=new PGlite();
+ let who='test-one',mail=PRIVATE_OWNER_EMAIL,now=Date.parse('2026-11-28T05:59:59Z');
+ const issuer='https://dream-journal.test';
+ try{
+  await db.exec('CREATE ROLE learner_runtime');
+  await db.exec(read('migrations/006_learner_accounts.sql'));
+  await db.exec(ddl);
+  await db.exec(ddl);
+  const make=origin=>createLearnerService({origin,repository:new LearnerRepository({transaction:fn=>db.transaction(tx=>fn(tx))}),identityProvider:restrictToPrivateOwner({issuer,resolve:async()=>who?{issuer,subject:who,name:'Synthetic',email:mail,emailVerified:true,sessionId:'synthetic-dream-journal-'+who,expiresAt:now+3600000}:null}),csrfSecret:'synthetic-dream-journal-secret-not-production',charts:async()=>null,now:()=>now});
+  const services={[DAILY_BALANCE_ORIGIN]:make(DAILY_BALANCE_ORIGIN),[LEARNER_ORIGIN]:make(LEARNER_ORIGIN)};
+  async function req(path='dream-journal',{payload,csrf,origin=DAILY_BALANCE_ORIGIN}={}){
