+const MOCK=/^mesmock1-\d{4}-\d{2}-\d{2}-(?:45|78)$/;
+export const MOCK_CATALOG_ENDPOINT='/api/learner/mock-charts/catalog';
+export const isMockChartId=id=>typeof id==='string'&&MOCK.test(id);
+export const isChartId=id=>typeof id==='string'&&(LEGACY.test(id)||MOCK.test(id));
+export const mockBrowser=()=>typeof location!=='undefined'&&location.origin==='https://dailybalancelogan.onrender.com';
+export const chartAssetPath=id=>isChartId(id)?isMockChartId(id)?'/api/learner/mock-charts/'+id:'/charts/'+id+'.json':null;
+export function appendMockCatalog(legacy,mock){const dates=new Set(legacy.map(r=>r.date??r.id.slice(-13,-3))),ids=new Set(legacy.map(r=>r.id));for(const row of mock){if(!isMockChartId(row.id)||row.url!==chartAssetPath(row.id)||row.date!==row.id.slice(-13,-3)||dates.has(row.date)||ids.has(row.id)||!row.title.startsWith('MOCK'))throw Error('Mock practice must append a unique missing date.');dates.add(row.date);ids.add(row.id);}return [...legacy,...mock];}
