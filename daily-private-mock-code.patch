+-- Add only private chart storage; no chart data is part of this migration.
+BEGIN;
+SET LOCAL lock_timeout = '5s';
+CREATE TABLE learner_app.owner_mock_charts (
+  account_id uuid NOT NULL REFERENCES learner_app.accounts(id),
+  session_date date NOT NULL CHECK (session_date BETWEEN DATE '2000-01-01' AND DATE '2099-12-31'),
+  chart_id text NOT NULL,
+  chart_sha256 text NOT NULL,
+  bar_count smallint NOT NULL CHECK (bar_count IN (45, 78)),
+  payload bytea NOT NULL CHECK (octet_length(payload) BETWEEN 1 AND 131072),
+  PRIMARY KEY (account_id, session_date),
+  UNIQUE (account_id, chart_id),
+  UNIQUE (account_id, chart_sha256),
+  CHECK (chart_id = 'mesmock1-' || to_char(session_date, 'YYYY-MM-DD') || '-' || bar_count),
+  CHECK (chart_sha256 = encode(sha256(payload), 'hex')),
+  CHECK (
+    coalesce((convert_from(payload, 'UTF8')::jsonb ->> 'id') = chart_id, false)
+    AND coalesce((convert_from(payload, 'UTF8')::jsonb ->> 'date') = to_char(session_date, 'YYYY-MM-DD'), false)
+    AND coalesce((convert_from(payload, 'UTF8')::jsonb ->> 'instrument') = 'MES', false)
+    AND coalesce((convert_from(payload, 'UTF8')::jsonb ->> 'range') = 'rth', false)
+    AND coalesce((convert_from(payload, 'UTF8')::jsonb -> 'intervalMinutes') = '5'::jsonb, false)
+    AND coalesce((convert_from(payload, 'UTF8')::jsonb -> 'version') = '1'::jsonb, false)
+    AND coalesce(jsonb_array_length(convert_from(payload, 'UTF8')::jsonb -> 'current') = bar_count, false)
+  )
+);
+REVOKE ALL ON learner_app.owner_mock_charts FROM PUBLIC, learner_runtime;
+GRANT SELECT ON learner_app.owner_mock_charts TO learner_runtime;
+COMMIT;
