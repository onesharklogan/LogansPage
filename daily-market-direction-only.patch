 /** The Trade Simulator's existing vertical zoom range. */
 export const validFavoriteTradeScale=value=>typeof value==='number'&&Number.isFinite(value)&&value>=.25&&value<=8;
+
+/** The existing Trade preset key is reused in Market Direction: only the span, not a price or chart. */
+const validLearnerId=id=>typeof id==='string'&&/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/.test(id);
+const storageFor=options=>options.storage===undefined?globalThis.localStorage:options.storage;
