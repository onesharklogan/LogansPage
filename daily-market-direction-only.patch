+export function priceSpanFrame(anchor,previousSpan,yZoom,savedSpan){
+ if(!anchor||![anchor.l,anchor.h,previousSpan,yZoom,savedSpan].every(Number.isFinite)||previousSpan<=0||savedSpan<=0||anchor.h<anchor.l)return null;
+ const range=anchor.h-anchor.l,priceSpan=range>savedSpan?range*1.1:savedSpan;
+ return {priceSpan,priceCenter:anchor.l+range/2,yZoom:clampZoom(yZoom*previousSpan/priceSpan)};
+}
