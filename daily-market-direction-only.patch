+'use client';
+import {useEffect,useRef,useState} from 'react';
+import {learnerClient} from '../lib/learner/client.mjs';
+import {chartAssetPath} from '../lib/chart-catalog.mjs';
+import {chartTrades} from '../lib/failed-chart-trades.mjs';
+import {loadSimulatorChart} from './trade-simulator-data.mjs';
+import {SavedTradeChart} from './failed-charts-book';
+import LoadingIndicator from './loading-indicator';
+
+/** Review the immutable account attempt and exact hashed chart, with no simulator or writes. */
+export default function LegacyTradeReview({capture,attemptId,onClose}:{capture:ReturnType<typeof learnerClient.captureContext>;attemptId:string;onClose:()=>void}){
+ const [loaded,setLoaded]=useState<{source:any;chart:any;trades:any[];points:number}|null>(null),[error,setError]=useState(false),heading=useRef<HTMLHeadingElement>(null);
+ useEffect(()=>{heading.current?.focus({preventScroll:true});},[]);
+ useEffect(()=>{
+  const controller=new AbortController();
+  const current=()=>!controller.signal.aborted&&!!capture&&learnerClient.guard(capture);
+  async function load(){
+   try{
+    if(!current()||!capture)return;
+    const attempt=await learnerClient.getAttempt(attemptId,capture);
+    if(!current())return;
+    const url=chartAssetPath(attempt.chartId);
+    if(attempt.module!=='trade-simulator'||!Number.isFinite(Date.parse(attempt.completedAt))||attempt.summary?.completedAttempts!==1||!url)throw Error('Invalid legacy chart selection.');
+    const chart=await loadSimulatorChart({id:attempt.chartId,sha256:attempt.chartSha256,url},{signal:controller.signal});
+    if(!current())return;
+    const source={id:attempt.chartId,sourceSha256:attempt.chartSha256,candles:chart.current};
+    const trades=chartTrades(attempt,source),points=attempt.summary?.netPoints;
+    if(!Number.isFinite(points)||Math.abs(points-trades.reduce((n,r)=>n+r.points,0))>1e-6)throw Error('Saved points did not reconcile.');
+    setLoaded({source,chart,trades,points});
+   }catch{if(current())setError(true);}
+  }
+  void load();return()=>controller.abort();
+ },[capture?.epoch,capture?.context?.accountId,capture?.context?.generation,capture?.context?.sessionTag,attemptId]);
+ const ready=!!capture&&learnerClient.guard(capture)&&loaded;
+ return <section aria-labelledby="legacy-review-title">
+  <button type="button" className="quiet-button" onClick={onClose}>Back to Trade History</button>
+  <h3 id="legacy-review-title" ref={heading} tabIndex={-1}>Saved Trade Simulator chart</h3>
+  <p>Read-only review. The original attempt and points are unchanged.</p>
+  {error?<p role="alert">The exact saved chart could not be verified. Your history is unchanged.</p>:ready?<><p>{ready.chart.title} · {ready.points.toLocaleString('en-US',{maximumFractionDigits:2})} points</p><SavedTradeChart source={ready.source} originalChart={ready.chart} trades={ready.trades} large/></>:<p role="status"><LoadingIndicator label="Loading the saved chart…"/></p>}
+ </section>;
+}
