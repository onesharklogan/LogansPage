+export function tradePriceSpanKey(learnerId){
+ if(!validLearnerId(learnerId))throw Error('Choose a verified learner account.');
+ return 'price-action-trade-price-span-v1:'+learnerId;
+}
+export const validTradePriceSpan=value=>typeof value==='number'&&Number.isFinite(value)&&value>=.000001&&value<=1e10;
+export function readTradePriceSpan(learnerId,options={}){
+ try{if(options.guard?.()!==true)return null;const raw=storageFor(options).getItem(tradePriceSpanKey(learnerId));if(options.guard?.()!==true||raw===null)return null;const value=raw.length<=32?JSON.parse(raw):null;return validTradePriceSpan(value)?value:null;}catch{return null;}
+}
