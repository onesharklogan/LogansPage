+ try{if(options.guard?.()!==true||!validTradePriceSpan(value))return false;const storage=storageFor(options),key=tradePriceSpanKey(learnerId),raw=JSON.stringify(value);storage.setItem(key,raw);return storage.getItem(key)===raw&&options.guard?.()===true;}catch{return false;}
+}
