--- /dev/null
+++ b/components/pattern-source-data.mjs
@@ -0,0 +1,18 @@
+import {isMockChartId} from '../lib/chart-catalog.mjs';
+import {historicalPrefix,historicalGap} from '../lib/chart-match.mjs';
+import {loadSimulatorCatalog,loadSimulatorChart} from './trade-simulator-data.mjs';
+
+// Source-only charts are never sent to rankPatternMatches or added to the pinned index.
+/** @param {{signal?:AbortSignal,fetcher?:typeof fetch,guard?:()=>boolean}} [options] */
+export async function loadOwnerPatternSources({signal,fetcher=fetch,guard}={}){
+ if(typeof guard!=='function'||!guard())return [];
+ const verifiedFetch=(url,init)=>fetcher(url,{...init,redirect:'error',cache:'no-store'});
+ const refs=(await loadSimulatorCatalog({signal,fetcher:verifiedFetch,mock:'archive'})).filter(ref=>isMockChartId(ref.id));
+ if(refs.length>8||signal?.aborted||!guard())return [];
+ const rows=await Promise.all(refs.map(async reference=>{
+  const chart=await loadSimulatorChart(reference,{signal,fetcher:verifiedFetch});
+  historicalPrefix(chart,chart.current.length,{useEma:true});historicalGap(chart);
+  return {reference,chart};
+ }));
+ return !signal?.aborted&&guard()?rows:[];
+}
