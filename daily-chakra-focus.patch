+  const focus=chakraForDay(day),markup=renderToStaticMarkup(jsx.jsx(Header,{section:'DAILY DASHBOARD',current:'/',brandMark:jsx.jsx(Mark,{focus}),headerTheme:focus.id,brandLabel:'Home · Chakra focus: '+focus.name,brandSubtitle:focus.name}));
+  assert.match(markup,new RegExp('data-header-theme="'+focus.id+'"'));
