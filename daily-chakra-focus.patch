+import assert from 'node:assert/strict';
+import test from 'node:test';
+import fs from 'node:fs';
+import vm from 'node:vm';
+import ts from 'typescript';
+import React from 'react';
+import * as jsx from 'react/jsx-runtime';
+import {renderToStaticMarkup} from 'react-dom/server';
+import {chakraForDay,dashboardChakra} from '../lib/chakra-focus.mjs';
+import {hourlyClock} from '../lib/learner/daily-hourly.mjs';
+
+const read=path=>fs.readFileSync(new URL('../'+path,import.meta.url),'utf8');
+const palettes=['ajna','anahata','svadhisthana'];
+const days=['2026-11-24','2026-11-25','2026-11-26'];
+test('stable three-day anchored sequence wraps across months/years including pre-anchor and leap dates',()=>{
+ assert.deepEqual(days.map(d=>chakraForDay(d).id),palettes);
+ assert.equal(chakraForDay('2026-11-27').id,'ajna');
+ assert.equal(chakraForDay('2026-11-23').id,'svadhisthana');
+ assert.equal(chakraForDay('2027-01-01').id,'svadhisthana');
+ assert.equal(new Set(['2024-02-28','2024-02-29','2024-03-01'].map(d=>chakraForDay(d).id)).size,3);
+ for(const value of [null,'2026-02-29','2026-02-31','2026-1-24','2026-11-24T00:00:00Z',''])assert.equal(chakraForDay(value),null);
+ assert.equal(chakraForDay(days[1]),chakraForDay(days[1]));
+});
+test('Chicago midnight advances once; historical selections stay pinned across reload and DST is a date, not elapsed hours',()=>{
+ const before=hourlyClock(Date.parse('2026-11-25T05:59:59Z')).day,after=hourlyClock(Date.parse('2026-11-25T06:00:00Z')).day;
+ assert.deepEqual([before,after],days.slice(0,2));
+ assert.equal(dashboardChakra({enabled:true,initialDay:before}).id,'ajna');
+ assert.equal(dashboardChakra({enabled:true,serverDay:before,clockDay:after}).id,'anahata');
+ assert.equal(dashboardChakra({enabled:true,serverDay:after,clockDay:before}).id,'anahata');
+ assert.equal(dashboardChakra({enabled:true,viewedDay:days[0],serverDay:after,clockDay:after}).id,'ajna');
+ assert.equal(dashboardChakra({enabled:true,viewedDay:days[0],clockDay:after}).id,'ajna');
+ assert.equal(dashboardChakra({enabled:false,serverDay:after}),null);
+ for(const [start,end] of [['2026-03-08T06:00:00Z','2026-03-09T05:00:00Z'],['2026-11-01T05:00:00Z','2026-11-02T06:00:00Z']]){
+  const a=hourlyClock(Date.parse(start)),b=hourlyClock(Date.parse(end));
+  assert.deepEqual([a.hour,b.hour],[0,0]);assert.notEqual(chakraForDay(a.day).id,chakraForDay(b.day).id);
+ }
+});
+function compiled(path){
+ const source=ts.transpileModule(read(path),{compilerOptions:{jsx:ts.JsxEmit.ReactJSX,module:ts.ModuleKind.CommonJS}}).outputText;
+ const exports={};vm.runInNewContext(source,{exports,require:name=>name==='react'?React:jsx});
+ return exports.default;
+}
+test('chakra artwork replaces the sun in exactly one branding slot; other headers keep the sun',()=>{
+ const Header=compiled('components/app-navigation.tsx'),Mark=compiled('components/daily-chakra-mark.tsx');
