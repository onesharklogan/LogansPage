+  assert.equal(markup.match(/class="app-candle-mark"/g)?.length,1);
+  assert.doesNotMatch(markup,/<circle cx="24"/);
+  icons.push(markup.match(/<svg class="app-candle-mark".*?<\/svg>/)?.[0]);
+ }
+ assert.equal(new Set(icons).size,3);
+ assert.match(read('app/page.tsx'),/initialChakraTime=\{process\.env\.LEARNER_APP_ORIGIN===DAILY_BALANCE_ORIGIN\?Date\.now\(\):undefined\}/);
+ assert.match(read('components/daily-dashboard.tsx'),/lastDate.current=next.date===next.today\?undefined:next.date;setChakraViewedDate\(lastDate.current\?\?null\)/);
+});
+const linear=n=>n<=.04045?n/12.92:((n+.055)/1.055)**2.4;
+function contrast(a,b){
+ const lum=h=>h.match(/[\da-f]{2}/g).map(n=>linear(parseInt(n,16)/255)).reduce((sum,n,i)=>sum+n*[.2126,.7152,.0722][i],0);
+ const values=[lum(a),lum(b)].sort((a,b)=>b-a);return (values[0]+.05)/(values[1]+.05);
+}
+test('all six header palettes have legible label and icon contrast on both gradient endpoints',()=>{
+ const css=read('components/daily-dashboard.module.css');
+ for(const id of palettes){
