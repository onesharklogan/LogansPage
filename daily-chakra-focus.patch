new file mode 100644
--- /dev/null
+++ b/lib/chakra-focus.mjs
@@ -0,0 +1,23 @@
+const FOCUS = Object.freeze([
+  Object.freeze({ id: 'ajna', name: 'Ajna' }),
+  Object.freeze({ id: 'anahata', name: 'Anahata' }),
+  Object.freeze({ id: 'svadhisthana', name: 'Svadhisthana' }),
+]);
+// November 24, 2026 (Chicago calendar date) is Ajna. UTC here is only a
+// day-number calculation after the app has selected its Chicago date.
+const ANCHOR = Date.UTC(2026, 10, 24);
+const MS_PER_DAY = 86_400_000;
+export function chakraForDay(day) {
+  if (typeof day !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(day)) return null;
+  const time = Date.parse(day + 'T00:00:00Z');
+  if (!Number.isFinite(time) || new Date(time).toISOString().slice(0, 10) !== day) return null;
+  const days = (time - ANCHOR) / MS_PER_DAY;
+  return FOCUS[((days % FOCUS.length) + FOCUS.length) % FOCUS.length];
+}
+
+/** A verified historical selection stays pinned; a live view follows the Chicago clock. */
+export function dashboardChakra({ enabled, viewedDay, serverDay, clockDay, initialDay }) {
+  if (!enabled) return null;
+  const today = serverDay && (!clockDay || serverDay > clockDay) ? serverDay : clockDay ?? initialDay;
+  return chakraForDay(viewedDay ?? today);
+}
