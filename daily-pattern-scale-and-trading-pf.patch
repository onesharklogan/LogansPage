new file mode 100644
--- /dev/null
+++ b/tests/trade-price-span-preference.test.mjs
@@ -0,0 +1,34 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readTradePriceSpan,saveTradePriceSpan,tradePriceSpanKey} from '../lib/trade-simulator-preferences.mjs';
+const owner='11111111-1111-4111-8111-111111111111',other='22222222-2222-4222-8222-222222222222';
+const harness=()=>{const map=new Map(),storage={getItem:key=>map.get(key)??null,setItem:(key,value)=>map.set(key,value)};return{map,storage,guard:()=>true};};
+
+test('stores one exact number across reloads, isolated by verified learner and browser',()=>{
+ const options=harness(),span=57.831243161;
+ assert.equal(readTradePriceSpan(owner,options),null);
+ assert.equal(saveTradePriceSpan(owner,span,options),true);
+ assert.deepEqual([...options.map],[[tradePriceSpanKey(owner),JSON.stringify(span)]]);
+ assert.equal(readTradePriceSpan(other,options),null);
+ assert.equal(readTradePriceSpan(owner,{...options}),span);
+ assert.equal(readTradePriceSpan(owner,harness()),null);
+ assert.equal(saveTradePriceSpan(other,24,options),true);
+ assert.equal(readTradePriceSpan(owner,options),span);
+ assert.equal(readTradePriceSpan(other,options),24);
+});
+test('rejects signed-out, stale, invalid or unavailable preferences without a trade or network write',()=>{
+ const options=harness();
+ assert.equal(saveTradePriceSpan(owner,48,options),true);
+ for(const bad of [0,-1,Infinity,NaN,'12',1e99])assert.equal(saveTradePriceSpan(owner,bad,options),false);
+ assert.equal(saveTradePriceSpan('other',25,options),false);
+ assert.equal(saveTradePriceSpan(owner,25,{...options,guard:()=>false}),false);
+ assert.equal(readTradePriceSpan(owner,{...options,guard:()=>false}),null);
+ assert.equal(readTradePriceSpan(owner,options),48);
+ let checks=0;
+ assert.equal(readTradePriceSpan(owner,{...options,guard:()=>++checks===1}),null);
+ const storage={getItem(){throw Error('blocked');},setItem(){throw Error('blocked');}};
+ assert.equal(readTradePriceSpan(owner,{storage,guard:()=>true}),null);
+ assert.equal(saveTradePriceSpan(owner,12,{storage,guard:()=>true}),false);
+ options.map.set(tradePriceSpanKey(other),JSON.stringify({span:12,center:100}));
+ assert.equal(readTradePriceSpan(other,options),null);
+});
